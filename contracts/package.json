{
  "name": "@cvtools/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "API contracts (oRPC + Zod) shared between cvTools back and front",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi": "pnpm build && node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "@orpc/contract": "1.15.4"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@orpc/openapi": "1.15.4",
    "@orpc/zod": "1.15.4",
    "typescript": "~6.0.3",
    "zod": "^4.6.5"
  }
}
