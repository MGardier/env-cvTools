# ═══════════════════════════════════════════════════════════════
#  env-cvTools — central infrastructure credentials
#  Copy to .env and fill in the passwords.
# ═══════════════════════════════════════════════════════════════

# ─── cvTools/back database (host port 5433) ───
API_POSTGRES_USER=root
API_POSTGRES_PASSWORD=password
API_POSTGRES_DB=cv_tools

# ─── ms-email database (host port 5435) ───
MS_EMAIL_POSTGRES_USER=root
MS_EMAIL_POSTGRES_PASSWORD=password
MS_EMAIL_POSTGRES_DB=ms_email

# ─── ms-applications database (host port 5454) ───
MS_APPLICATIONS_POSTGRES_USER=root
MS_APPLICATIONS_POSTGRES_PASSWORD=password
MS_APPLICATIONS_POSTGRES_DB=ms_applications

# ─── Test database (host port 5434, ephemeral) ───
TEST_POSTGRES_USER=test
TEST_POSTGRES_PASSWORD=test
TEST_POSTGRES_DB=cv_tools_test

# ─── RabbitMQ (5672 / UI 15672) ───
RABBITMQ_USER=root
RABBITMQ_PASSWORD=password

# ─── pgAdmin (http://localhost:5050) ───
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=password
